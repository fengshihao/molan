{
  "name": "@molan/host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./iframe-bridge.js": "./dist/iframe-bridge.js",
    "./vscode-bridge.js": "./dist/vscode-bridge.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/run-ts-tests.mjs"
  },
  "dependencies": {
    "@molan/protocol": "file:../molan-protocol",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
